# Hermes home secrets — copy to `.env` in the mounted agent home.
# NEVER commit the real .env. On Railway, set these as service variables.

# DeepSeek powers the agent (config.yaml uses an OpenAI-compatible provider,
# so the key is read from OPENAI_API_KEY). Use Doré's DeepSeek key.
OPENAI_API_KEY=your-deepseek-api-key

# Doré's own services read these (the MCP server runs inside the sca package).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
