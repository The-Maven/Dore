# LLM provider — used by attestation extraction and analysis synthesis.
# Copy to .env and fill in. .env is gitignored.

LLM_API_KEY=                          # required for live LLM calls
LLM_PROVIDER=deepseek                 # deepseek | anthropic
LLM_BASE_URL=https://api.deepseek.com # OpenAI-compatible base URL
LLM_MODEL=deepseek-chat               # model name

# Optional: override the public RPC endpoints in config/stablecoins.yaml
# ETHEREUM_RPC_URL=
