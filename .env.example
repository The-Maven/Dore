# Doré — environment variables.
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit values.
# This file lists every env var the app reads, names only.

# ── LLM (required for live analysis) ──────────────────────────────────
# DeepSeek (default) or Anthropic via the OpenAI-compatible client.
LLM_API_KEY=                          # required for live LLM calls
LLM_PROVIDER=deepseek                 # deepseek | anthropic
LLM_BASE_URL=https://api.deepseek.com # OpenAI-compatible base URL
LLM_MODEL=deepseek-chat               # fast tier (≤ 2s hops)
LLM_MODEL_DEEP=                       # optional deep tier; falls back to fast
LLM_TIMEOUT_S=                        # optional override (seconds)

# ── Fallback LLM (optional, ladder kicks in if primary fails) ─────────
ANTHROPIC_API_KEY=                    # optional; enables sca.llm.fallback

# ── Supabase (required for production / persisted analyses) ───────────
# When unset, the app uses FileStore (in-memory analyses; transient).
# SUPABASE_ANON_KEY is exposed to the SPA via /api/config — designed
# public, paired with row-level security. The SERVICE key MUST stay
# server-side: it bypasses RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Chain RPC overrides (optional) ────────────────────────────────────
# Defaults are public endpoints in config/stablecoins.yaml. Override with
# either a single URL or a comma-separated pool.
# ETHEREUM_RPC_URL=
# ETHEREUM_RPCS=https://rpc1,https://rpc2
# TRON_PRO_API_KEY=                    # optional; raises Tron rate limits

# ── Web server tuning ─────────────────────────────────────────────────
SCA_RATE_BURST=10                     # per-IP token bucket capacity
SCA_RATE_REFILL_PER_S=0.5             # refill rate (tokens/sec)
SCA_TRUST_PROXY=                      # "1" in production behind Cloudflare/Railway;
                                      # otherwise X-Forwarded-For is ignored
SCA_JOB_POOL=4                        # max concurrent analysis jobs
SCA_JOB_TTL_S=3600                    # how long completed jobs linger in memory

# ── Background canary ─────────────────────────────────────────────────
SCA_HEALTH_INTERVAL_HOURS=6           # source-health sweep cadence
SCA_HEALTH_DISABLED=                  # "1" disables the canary (useful in CI)

# ── Observability ─────────────────────────────────────────────────────
SCA_LOG=                              # debug | info (default: warn-and-above)
NO_COLOR=                             # "1" disables ANSI in CLI output

# ── Augmentation (optional) ───────────────────────────────────────────
SCA_AUGMENT_WEB=                      # "1" lets augmentation hit web tools
